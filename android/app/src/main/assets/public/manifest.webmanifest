{"name":"PatricksPDF","short_name":"PatricksPDF","description":"Local, offline-ready tool for signing PDFs, adding customizable text overlays, filling form fields, managing pages, and reading with reflow.","start_url":"/","display":"standalone","background_color":"#f8fafc","theme_color":"#2563eb","lang":"en","scope":"/","id":"/","share_target":{"action":"/share-target","method":"POST","enctype":"multipart/form-data","params":{"title":"title","text":"text","url":"url","files":[{"name":"pdfFile","accept":["application/pdf",".pdf"]}]}},"file_handlers":[{"action":"/openFile","accept":{"application/pdf":[".pdf"]}}],"icons":[{"src":"/pwa-192x192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"/pwa-512x512.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"/pwa-maskable-512x512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}]}
